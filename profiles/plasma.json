{
  "id": "plasma",
  "display_name": "KDE Plasma on WaylandNative",
  "protocol": "wayland-native",
  "summary": "KDE Plasma shell layout over native Wayland broker",
  "degraded_profile_id": "demo-x11-degraded",
  "broker_services": [
    "displayd",
    "sessiond",
    "watchdog"
  ],
  "session_components": [
    {
      "id": "kwin",
      "role": "window-manager",
      "command": ["kwin_wayland", "--replace"],
      "critical": true,
      "launcher": "system"
    },
    {
      "id": "plasmashell",
      "role": "shell",
      "command": ["plasmashell"],
      "critical": true,
      "launcher": "system"
    }
  ],
  "service_component_bindings": [],
  "service_recovery_execution_policies": []
}
